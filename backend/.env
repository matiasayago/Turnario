# Copiá a `.env` en esta carpeta (TurnarioApp/backend). Nunca subas `.env` al repositorio.

# --- Entorno (local + Gmail: development; servidor real: production) ---
NODE_ENV=development
# Orígenes web que llaman al API (separados por coma). Incluí URLs de admin si aplica.
FRONTEND_URL=https://app.tudominio.com,https://admin.tudominio.com
# Detrás de Nginx / Cloudflare / balanceador: activá trust proxy para rate limit e IP correcta
TRUST_PROXY=1

# Reemplazá por la URI COMPLETA de Atlas (Connect en el panel) o usá Mongo local:
MONGODB_URI=mongodb://127.0.0.1:27017/turnario
JWT_SECRET=genera_un_secreto_largo_y_unico

# Mercado Pago LIVE (backend únicamente)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MERCADOPAGO_WEBHOOK_SECRET=

PORT=3001
HOST=0.0.0.0

# --- Email (SMTP / Gmail) y avisos de citas ---
# Gmail (requiere NODE_ENV=development y contraseña de aplicación de Google):
EMAIL_USER=matiasayago@gmail.com
EMAIL_APP_PASSWORD=sqej enhy lgkh wuaq
EMAIL_FROM=matiasayago@gmail.com
EMAIL_FROM_NAME=Turnario
# Producción (NODE_ENV=production): SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_SECURE=true|false
# Prueba: POST http://localhost:3001/api/email/send-test  (ver mensaje en consola del servidor)
# Si EMAIL_APPOINTMENT_NOTIFICATIONS=0 se omiten mails automáticos de citas.
# Preferencias por usuario: preferences.notifications.email (default true) y appointmentReminders para el recordatorio ~24h.
#
# EMAIL_APPOINTMENT_NOTIFICATIONS=1
# EMAIL_DEFAULT_CLINIC_NAME=Turnario
# EMAIL_DEFAULT_CLINIC_ADDRESS=
# EMAIL_DEFAULT_CLINIC_PHONE=

# Zona horaria del servidor (recordatorios 24h y fechas de turno)
TZ=America/Argentina/Buenos_Aires

# --- Recordatorios de cita (~24h antes) ---
# En varias réplicas del API: dejá el job solo en una instancia (DISABLE=1 en el resto).
# DISABLE_APPOINTMENT_REMINDER_JOB=1
# APPOINTMENT_REMINDER_INTERVAL_MS=900000
# APPOINTMENT_REMINDER_QUERY_LIMIT=800

# --- WhatsApp Business API (Meta Cloud) ---
# Activá en Meta Developers → WhatsApp → API Setup (Phone number ID + permanent token).
# Las plantillas deben estar APROBADAS y con el mismo número de variables que envía el backend.
#
# WHATSAPP_CLOUD_ENABLED=1
# WHATSAPP_CLOUD_ACCESS_TOKEN=EAAxxxxxxxx...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_GRAPH_API_VERSION=v21.0
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=un_secreto_para_verify
# WHATSAPP_REQUIRE_OPT_IN=1
# WHATSAPP_TEMPLATE_LANG=es
#
# Nombres de plantilla en Meta (ejemplos; creá las tuyas y ajustá acá):
# WHATSAPP_TEMPLATE_CONFIRMED=turnario_cita_confirmada
# WHATSAPP_TEMPLATE_REJECTED=turnario_cita_rechazada
# WHATSAPP_TEMPLATE_CANCELLED_PRO=turnario_cita_cancelada_pro
# WHATSAPP_TEMPLATE_REMINDER_24H=turnario_recordatorio_24h
# WHATSAPP_TEMPLATE_TEST=hello_world
#
# Variables enviadas por el backend (deben coincidir con la plantilla):
# - CONFIRMED: {{1}} profesional, {{2}} fecha, {{3}} hora, {{4}} servicio
# - REJECTED:  {{1}} profesional, {{2}} fecha, {{3}} hora, {{4}} servicio
# - CANCELLED_PRO: {{1}} profesional, {{2}} servicio, {{3}} fecha, {{4}} hora
# - REMINDER_24H: {{1}} servicio, {{2}} profesional, {{3}} fecha, {{4}} hora
#
# Webhook URL pública (Meta): https://TU_DOMINIO/api/v1/whatsapp/webhook
# Opt-in vía API (usuario logueado): POST /api/v1/whatsapp/preferences  body: {"enabled":true}
# Prueba: POST /api/v1/whatsapp/send-test  Authorization: Bearer <jwt>
#
# --- WhatsApp vía Twilio (alternativa a Meta Cloud) ---
# Si TWILIO_WHATSAPP_ENABLED=1, el backend usa Twilio y NO Meta para enviar.
# En WHATSAPP_TEMPLATE_* poné el Content SID de Twilio (ej. HXxxxxxxxx…), no el nombre Meta.
#
# TWILIO_WHATSAPP_ENABLED=1
# TWILIO_ACCOUNT_SID=ACxxxxxxxx...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Opcional: mensaje de texto libre en send-test (solo 24h / sandbox): TWILIO_WHATSAPP_ALLOW_BODY=1
#
# Mismas claves WHATSAPP_TEMPLATE_CONFIRMED, etc., pero valores = ContentSid de plantillas creadas en Twilio.

# --- Google Play: suscripción Turnario Pro ---
# Debe coincidir con applicationId de la app (ver my-app/app.json → android.package).
ANDROID_PACKAGE_NAME=com.turnariopro.app
GOOGLE_PLAY_SUBSCRIPTION_SKUS=turnario_pro_monthly
# GOOGLE_PLAY_SERVICE_ACCOUNT_KEYFILE=/ruta/segura/service-account.json
# Nunca en producción:
# ALLOW_PLAY_SUBSCRIPTION_DEV_BYPASS=1

# --- Desarrollo local (ejemplo) ---
# NODE_ENV=development
# MONGODB_URI=mongodb://localhost:27017/turnario
# JWT_SECRET=dev_only
# MERCADOPAGO_ACCESS_TOKEN=TEST-...
# MERCADOPAGO_PUBLIC_KEY=TEST-...
# FRONTEND_URL=http://localhost:3000
# TRUST_PROXY=0

# --- Script: npm run create-super-professional ---
# SUPER_PRO_EMAIL=super.professional@turnario.local
# SUPER_PRO_PASSWORD=TuClaveSegura123
# SUPER_PRO_FORCE_PASSWORD=1
