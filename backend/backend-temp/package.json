{
  "name": "turnario-backend",
  "version": "1.0.0",
  "description": "Backend API para el sistema de gestión de citas y reservas Turnario",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "docs:generate": "swagger-jsdoc -d swaggerDef.js -o docs/swagger.json",
    "docs:serve": "swagger-ui-express docs/swagger.json",
    "setup-db": "node scripts/setup-database.js",
    "setup-db:dev": "NODE_ENV=development node scripts/setup-database.js",
    "setup-atlas": "node scripts/setup-atlas.js",
    "reset-db": "node scripts/setup-database.js --reset",
    "seed": "node scripts/setup-database.js --seed-only",
    "configure-mongodb": "node scripts/configure-mongodb.js",
    "install-mongodb": "powershell -ExecutionPolicy Bypass -File scripts/install-mongodb-windows.ps1",
    "install-mongodb:unix": "bash scripts/install-mongodb-unix.sh",
    "test-connection": "node test-connection.js",
    "test-mongodb": "node test-mongodb-config.js",
    "test-frontend": "node test-frontend-connection.js"
  },
  "keywords": [
    "api",
    "rest",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "authentication",
    "booking",
    "appointments"
  ],
  "author": "Turnario Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mongodb": "^4.17.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.4",
    "sharp": "^0.32.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.4",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.6.2",
    "jest-environment-node": "^29.6.2",
    "mongodb-memory-server": "^8.12.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "prettier"
    ],
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "error",
      "prefer-const": "error"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2
  }
}
