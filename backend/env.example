# ===== CONFIGURACIÓN DEL SERVIDOR =====
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# ===== BASE DE DATOS =====
MONGODB_URI=mongodb://localhost:27017/turnario

# ===== JWT =====
JWT_SECRET=tu_jwt_secret_super_seguro_aqui
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===== EMAIL (GMAIL) =====
EMAIL_USER=tu_email@gmail.com
EMAIL_APP_PASSWORD=tu_contraseña_de_aplicacion_gmail
EMAIL_FROM=tu_email@gmail.com
EMAIL_FROM_NAME=Turnario
SUPPORT_EMAIL=soporte@turnario.com

# ===== EMAIL (SMTP PRODUCCIÓN) =====
SMTP_HOST=smtp.tuservidor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_contraseña_smtp

# ===== MERCADOPAGO =====
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ===== GOOGLE MAPS (OPCIONAL) =====
GOOGLE_MAPS_API_KEY=tu_api_key_de_google_maps

# ===== REDIS (OPCIONAL PARA CACHE) =====
REDIS_URL=redis://localhost:6379

# ===== LOGS =====
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ===== SEGURIDAD =====
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== UPLOADS =====
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# ===== NOTIFICACIONES =====
PUSH_NOTIFICATIONS_ENABLED=true
PUSH_PRIVATE_KEY=tu_clave_privada_push
PUSH_PUBLIC_KEY=tu_clave_publica_push

# ===== ANALYTICS =====
ANALYTICS_ENABLED=false
ANALYTICS_TRACKING_ID=tu_id_de_seguimiento

