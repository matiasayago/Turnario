{
  "name": "turnario-backend",
  "version": "1.0.0",
  "description": "Backend multirubro para sistema de gestión de citas y reservas - Soporta múltiples tipos de negocios (médico, belleza, fitness, educación, consultoría, reparación, limpieza, transporte, comida, retail, etc.)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "setup": "npm install && npm run init-db",
    "init-db": "node scripts/init-db.js"
  },
  "keywords": [
    "turnario",
    "citas",
    "reservas",
    "agenda",
    "multirubro",
    "negocios",
    "servicios",
    "profesionales",
    "clientes",
    "rest-api",
    "nodejs",
    "express",
    "mongodb",
    "websockets",
    "notificaciones",
    "pagos",
    "geolocalizacion",
    "emails",
    "mercadopago"
  ],
  "author": "Turnario Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^6.10.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "socket.io": "^4.7.2",
    "nodemailer": "^6.9.4",
    "mercadopago": "^2.0.7",
    "geolib": "^3.3.4",
    "handlebars": "^4.7.8",
    "sharp": "^0.32.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}

