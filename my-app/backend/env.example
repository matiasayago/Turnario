# Copiá a `.env` en my-app/backend (no subir al repo).

PORT=3001
NODE_ENV=development
HOST_IP=192.168.0.11

# Obligatorio en producción: string largo y único
JWT_SECRET=cambiá-esto-por-un-secreto-largo

# Local: mongodb://localhost:27017/turnario
# Producción (Atlas): mongodb+srv://USER:PASS@cluster.mongodb.net/turnario?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/turnario

# --- Email (recuperación de contraseña) ---
# Opción A — Gmail (desarrollo):
# EMAIL_USER=tu@gmail.com
# EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_FROM=tu@gmail.com
# EMAIL_FROM_NAME=Turnario

# Opción B — SMTP genérico:
# SMTP_HOST=smtp.turnarioapp.com.ar
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_SECURE=false
# EMAIL_FROM=noreply@turnarioapp.com.ar

# Opción C — Resend (recomendado en cloud):
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Turnario <noreply@turnarioapp.com.ar>

# Deep link de la app (debe coincidir con app.json → scheme)
EXPO_APP_SCHEME=myapp

# Orígenes web permitidos / links en emails
# FRONTEND_URL=https://app.turnarioapp.com.ar,https://turnarioapp.com.ar

# Sign in with Apple (mismo bundle que app.json)
APPLE_BUNDLE_ID=com.turnariopro.app

# SUPPORT_EMAIL=soporte@turnarioapp.com.ar

# Solo desarrollo: si el email falla, devolver token en la respuesta JSON
# ALLOW_LOCAL_RESET_TOKEN=1

# Detrás de proxy HTTPS (Railway / Nginx)
# TRUST_PROXY=1

# --- Mercado Pago (señas Checkout Pro) ---
# Credenciales en https://www.mercadopago.com.ar/developers/panel/app
# Sandbox: tokens TEST-...  |  Producción: APP_USR-...
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# URL pública del backend (obligatoria para que MP pueda llamar al webhook)
# BACKEND_URL=https://api.turnarioapp.com.ar
# En desarrollo con túnel: BACKEND_URL=https://xxxx.ngrok-free.app
