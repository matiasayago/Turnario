# Copiá a `.env` en my-app/backend (no subir al repo).

# --- Email (recuperación de contraseña) ---
# Opción A — Gmail (desarrollo):
# EMAIL_USER=tu@gmail.com
# EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_FROM=tu@gmail.com
# EMAIL_FROM_NAME=Turnario

# Opción B — SMTP genérico:
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_SECURE=false
# EMAIL_FROM=no-reply@tudominio.com

# Opción C — Resend (recomendado si SMTP falla):
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Turnario <no-reply@tudominio.com>

# Deep link de la app (debe coincidir con app.json → scheme)
EXPO_APP_SCHEME=myapp

# URL web opcional para el botón del mail (si no hay, se usa el deep link de la app)
# FRONTEND_URL=https://app.tudominio.com

# SUPPORT_EMAIL=soporte@turnario.com

# Solo desarrollo: si el email falla o no hay SMTP, devolver token en la respuesta JSON
# ALLOW_LOCAL_RESET_TOKEN=1
