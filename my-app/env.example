# Copiá a `.env` en esta carpeta (my-app). Reiniciá Expo tras cambios.
# En producción: definí las variables como secretos de EAS (eas secret:create) o en el perfil de build.

# --- Obligatorio en builds de tienda (HTTPS público del API) ---
# Ej.: https://api.tudominio.com  (sin barra final; sin /api/v1)
# En EAS: eas secret:create --name EXPO_PUBLIC_BACKEND_URL --value https://...
EXPO_PUBLIC_BACKEND_URL=https://api.tudominio.com
# Misma host que el API, esquema wss:// si el servidor expone WebSocket seguro
EXPO_PUBLIC_WEBSOCKET_URL=wss://api.tudominio.com
# Perfil de runtime (en build `production` de eas.json ya se fuerza "production")
EXPO_PUBLIC_APP_ENVIRONMENT=production
EXPO_PUBLIC_AUTO_LOGOUT_MINUTES=20
EXPO_PUBLIC_AUTO_LOGOUT_WARNING_SECONDS=30

# --- Desarrollo local (misma Wi-Fi que el teléfono) ---
# EXPO_PUBLIC_BACKEND_URL=http://192.168.1.20:3001
# EXPO_PUBLIC_WEBSOCKET_URL=ws://192.168.1.20:3001
# EXPO_PUBLIC_APP_ENVIRONMENT=development
# Opcional: sobrescribe la base de la API
# EXPO_PUBLIC_API_URL=https://api.tudominio.com/api/v1

# --- Google Sign-In (mismo proyecto en Google Cloud Console) ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=tu_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=tu_google_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=tu_google_android_client_id.apps.googleusercontent.com

# Mercado Pago (solo clave pública en la app; ACCESS TOKEN solo en backend/.env)
# Producción: claves LIVE (no TEST-)
EXPO_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EXPO_PUBLIC_MERCADOPAGO_SANDBOX=false

# Opcional
# EXPO_PUBLIC_VAPID_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# EXPO_PUBLIC_GOOGLE_PLAY_SUBSCRIPTION_SKU=turnario_pro_monthly
# EXPO_PUBLIC_ANALYTICS_ID=
# EXPO_PUBLIC_SENTRY_DSN=

# Soporte in-app (Configuración -> Aplicación -> Ayuda y Soporte)
EXPO_PUBLIC_SUPPORT_EMAIL=matiasayago@gmail.com
# Formato recomendado E.164 para llamadas (ej. +54911...)
EXPO_PUBLIC_SUPPORT_PHONE=+5491159572137
# Solo dígitos con código país para wa.me (ej. 54911...)
EXPO_PUBLIC_SUPPORT_WHATSAPP_PHONE=5491159572137
